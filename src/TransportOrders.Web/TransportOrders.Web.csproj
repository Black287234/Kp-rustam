<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Модуль заявок на служебный транспорт: веб-приложение ASP.NET Core MVC -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TransportOrders.Web</RootNamespace>
    <Company>ЧПОУ «СКП»</Company>
    <Authors>Лыхин Рустам Владимирович</Authors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
  </ItemGroup>

  <!-- SQL-скрипты миграций встраиваются в сборку и выполняются при запуске -->
  <ItemGroup>
    <EmbeddedResource Include="Data/Migrations/*.sql" />
  </ItemGroup>

</Project>
