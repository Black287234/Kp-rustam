@model IReadOnlyList<TripRequest>
@if (Model.Count == 0)
{
    <p class="empty">По заданным условиям заявок нет.</p>
}
else
{
<p class="muted small">Найдено заявок: @Model.Count</p>
<table class="grid">
    <thead><tr><th>Номер</th><th>Когда</th><th>Куда и зачем</th><th>Заявитель</th><th class="num">Пасс.</th><th>Автомобиль</th><th>Статус</th></tr></thead>
    <tbody>
    @foreach (var t in Model)
    {
        <tr>
            <td><a href="/Trips/Card/@t.Id">@t.Number</a></td>
            <td class="nowrap">@t.StartsAt.ToString("dd.MM.yyyy")<br /><small>@t.StartsAt.ToString("HH:mm")–@t.EndsAt.ToString("HH:mm")</small></td>
            <td>@t.Destination<br /><small class="muted">@t.Purpose</small></td>
            <td>@t.RequesterName</td>
            <td class="num">@t.Passengers</td>
            <td>@if (t.CarPlate is not null) { <span class="plate">@t.CarPlate</span> } else { <span class="muted">—</span> }</td>
            <td><span class="status @t.Status.Css()">@t.Status.Text()</span></td>
        </tr>
    }
    </tbody>
</table>
}
