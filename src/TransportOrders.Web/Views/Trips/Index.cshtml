@model TripListPage
@{
    ViewData["Title"] = "Заявки";
    var f = Model.Filter;
    var cars = (IReadOnlyList<Car>)ViewData["cars"]!;
}
<div class="head">
    <h1>Заявки на поездки</h1>
    <a class="btn" asp-action="Create">Новая заявка</a>
</div>
<form method="get" class="filters" hx-get="/Trips" hx-target="#trip-rows" hx-push-url="true"
      hx-trigger="change, input changed delay:400ms from:input[type=search]">
    <input type="search" name="Text" value="@f.Text" placeholder="Маршрут, цель или заявитель" aria-label="Поиск" />
    <select name="Status" aria-label="Статус">
        <option value="">Все статусы</option>
        @foreach (var s in Enum.GetValues<TripStatus>()) { <option value="@s" selected="@(f.Status == s)">@s.Text()</option> }
    </select>
    <label class="inline">с <input type="date" name="DayFrom" value="@f.DayFrom?.ToString("yyyy-MM-dd")" /></label>
    <label class="inline">по <input type="date" name="DayTo" value="@f.DayTo?.ToString("yyyy-MM-dd")" /></label>
    <select name="CarId" aria-label="Автомобиль">
        <option value="">Любой автомобиль</option>
        @foreach (var c in cars) { <option value="@c.Id" selected="@(f.CarId == c.Id)">@c.Plate</option> }
    </select>
    <label class="inline"><input type="checkbox" name="OpenOnly" value="true" checked="@f.OpenOnly" /> только незакрытые</label>
    <noscript><button class="btn light" type="submit">Показать</button></noscript>
    <a class="reset" href="/Trips">сбросить</a>
</form>
<div id="trip-rows">
    <partial name="_Rows" model="Model.Trips" />
</div>
