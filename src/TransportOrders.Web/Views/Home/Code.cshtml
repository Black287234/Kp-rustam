@model int
@{ ViewData["Title"] = Model == 404 ? "Не найдено" : $"Ошибка {Model}"; }
<section class="notice">
    <h1>@(Model == 404 ? "Запись не найдена" : $"Ошибка {Model}")</h1>
    <p>@(Model == 404 ? "Запрошенной страницы или записи нет. Проверьте адрес или вернитесь к списку." : "Запрос не выполнен.")</p>
    <a class="btn" href="/">На главную</a>
</section>
